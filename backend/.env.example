# Choose: openai or ollama
LLM_PROVIDER=ollama

# Hosted API settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding model; first run downloads it
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload safety limit in MB
MAX_UPLOAD_MB=20
