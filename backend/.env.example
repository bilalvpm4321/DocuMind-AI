# Choose: openai or ollama
LLM_PROVIDER=ollama

# Hosted API settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Multilingual embedding model; first run downloads it (supports English, Malayalam, Hindi, etc.)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Upload safety limit in MB
MAX_UPLOAD_MB=20

# Answer language: en (English) or ml (Malayalam)
DEFAULT_ANSWER_LANGUAGE=en

# Optional: set OLLAMA_NUM_GPU=0 to force CPU mode if GPU VRAM is tight (-1 = default autodetect)
OLLAMA_NUM_GPU=-1
